# ==============================================================================
# AI Customer Support Avatar - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LiveKit Cloud Credentials (https://cloud.livekit.io)
# Sign up for a free LiveKit Cloud account, create a project, and generate API keys
# under Settings -> Keys.
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ------------------------------------------------------------------------------
# 2. Synthesia API Key & Avatar ID (https://docs.synthesia.io)
# Requires an active Synthesia workspace with Interactive Avatars enabled.
# Generate your API key in the Synthesia developer settings.
# ------------------------------------------------------------------------------
SYNTHESIA_API_KEY=your_synthesia_api_key_here

# Required: The specific gallery ID of the avatar accessible in your Synthesia workspace.
# Look up available avatar IDs in your Synthesia workspace settings / gallery.
# (Example gallery ID: 7572faa9-15da-400d-8227-ef1ab8932523)
SYNTHESIA_AVATAR_ID=your_synthesia_avatar_id_here

# ------------------------------------------------------------------------------
# 3. OpenAI API Key (https://platform.openai.com)
# Used for VAD, Speech-to-Text (STT), LLM reasoning, and Text-to-Speech (TTS).
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
