# ==============================================================================
# AI Customer Support Avatar - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LiveKit Cloud Credentials (https://cloud.livekit.io)
# Sign up for a free LiveKit Cloud account, create a project, and generate API keys
# under Settings -> Keys.
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ------------------------------------------------------------------------------
# 2. LLM / STT / TTS API Keys
# By default, uses GROQ_API_KEY (or OPENAI_API_KEY) and LiveKit Cloud inference.
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 3. OpenAI API Key (https://platform.openai.com)
# Used for VAD, Speech-to-Text (STT), LLM reasoning, and Text-to-Speech (TTS).
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
